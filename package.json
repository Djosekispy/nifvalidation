{
  "name": "@djosekispy/nifvalidation",
  "version": "2.0.1",
  "description": "Biblioteca para consulta de NIF/BI de contribuintes em Angola.",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "run:real": "node scripts/run-real-nif.js",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com"
  },
  "keywords": [
    "nif",
    "angola",
    "puppeteer",
    "consulta",
    "validacao",
    "minfin"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "puppeteer": "^24.35.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Djosekispy/nifvalidation.git"
  }
}
